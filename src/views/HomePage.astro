---
/** The home page; src/pages/index.astro and src/pages/el/index.astro render it. */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Rail from '../components/Rail.astro';
import RoleCard from '../components/RoleCard.astro';
import PosterCard from '../components/PosterCard.astro';
import ClientTile from '../components/ClientTile.astro';
import ReviewCard from '../components/ReviewCard.astro';
import PostCard from '../components/PostCard.astro';
import RoleDialog from '../components/RoleDialog.astro';
import Synopsis from '../components/Synopsis.astro';
import CareerGuide from '../components/CareerGuide.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import Credits from '../components/Credits.astro';
import Contact from '../components/Contact.astro';
import { getContent } from '../data/content';
const { caseStudies, clients, experience, posts, recommendations, t } = getContent(Astro.currentLocale);

// Each client tile opens the most recent role that client appears in.
const roleFor = (name: string) => experience.find((r) => r.clients.includes(name))?.id;
---
<Base>
  <Hero />

  <Rail id="experience" title={t('ui.rails.experience')} meta={t('ui.rails.experience_meta', { count: experience.length })} hint>
    {experience.map((role) => <RoleCard role={role} />)}
  </Rail>

  <Rail id="work" title={t('ui.rails.work')} meta={t('ui.rails.work_meta')}>
    {caseStudies.map((cs) => <PosterCard cs={cs} />)}
  </Rail>

  <Rail id="reviews" title={t('ui.rails.reviews')} meta={t('ui.rails.reviews_meta', { count: recommendations.length })}>
    {recommendations.map((rec) => <ReviewCard rec={rec} />)}
  </Rail>

  <Rail id="clients" title={t('ui.rails.clients')} meta={t('ui.rails.clients_meta', { count: clients.length })}>
    {clients.map((c) => <ClientTile client={c} roleId={roleFor(c.name)} />)}
  </Rail>

  <Rail id="posts" title={t('ui.rails.posts')} meta={t(posts.length === 1 ? 'ui.rails.posts_meta_one' : 'ui.rails.posts_meta', { count: posts.length })}>
    {posts.map((p) => <PostCard post={p} />)}
  </Rail>

  <CareerGuide />
  <Synopsis />
  <Skills />
  <Certifications />
  <Credits />
  <Contact />

  {experience.map((role) => <RoleDialog role={role} />)}
</Base>
