---
import type { GetStaticPaths } from 'astro';
import { Marked } from 'marked';
import { markedSmartypants } from 'marked-smartypants';
import { gfmHeadingId } from 'marked-gfm-heading-id';
import Base from '../../layouts/Base.astro';
import Rail from '../../components/Rail.astro';
import PosterCard from '../../components/PosterCard.astro';
import ImpactChart from '../../components/ImpactChart.astro';
import MvvmArchitecture from '../../components/MvvmArchitecture.astro';
import MvvmDiagrams from '../../components/MvvmDiagrams.astro';
import { getContent } from '../../data/content';

export const getStaticPaths = (() => getContent('en').caseStudies.map((cs) => ({ params: { slug: cs.slug } }))) satisfies GetStaticPaths;

const { caseStudies, platformStyle, profile, t } = getContent(Astro.currentLocale);
const d = caseStudies.find((cs) => cs.slug === Astro.params.slug)!;
const others = caseStudies.filter((cs) => cs.slug !== d.slug);

// The case study text is Markdown in the database; a line "{{impact-chart}}" places the impact chart.
const markdown = new Marked(gfmHeadingId(), markedSmartypants());
const parts = d.body.split(/^\{\{impact-chart\}\}$/m).map((chunk) => markdown.parse(chunk.trim()) as string);

const facts = [
  { label: t('ui.case.client'), value: d.client },
  { label: t('ui.case.platform'), value: platformStyle[d.platform].name },
  { label: t('ui.case.role'), value: d.role },
  { label: t('ui.case.when'), value: d.period },
  ...(d.team ? [{ label: t('ui.case.team'), value: d.team }] : []),
];
---
<Base title={d.title} description={d.summary}>
  <article>
    <header class="cs-hero art" style={`--h: ${d.hue}`}>
      <div class="wrap cs-hero-inner">
        <a class="back" href="/#work">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg>
          {t('ui.case.back')}
        </a>
        <p class="eyebrow-art"><span class="badge">{platformStyle[d.platform].badge}</span>{d.period}</p>
        <h1>{d.title}</h1>
        <p class="subtitle">{d.subtitle}</p>
        {
          d.metric && (
            <p class="metric">
              <strong>{d.metric.value}</strong>
              <span>{d.metric.label}</span>
            </p>
          )
        }
      </div>
    </header>

    <div class="wrap cs-body">
      <div class="prose-cs">
        <p class="lede">{d.summary}</p>
        {
          parts.map((html, i) => (
            <>
              <Fragment set:html={html} />
              {i < parts.length - 1 && <ImpactChart />}
            </>
          ))
        }
      </div>
      <aside class="side" aria-label={t('ui.case.details_label')}>
        <dl>
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <ul class="tags" aria-label={t('ui.case.tags_label')}>
          {d.tags.map((t) => <li class="chip">{t}</li>)}
        </ul>
        <div class="side-cta">
          <a class="btn btn-primary" href="/#contact">{t('ui.common.get_in_touch')}</a>
          <a class="btn btn-ghost" href={profile.cvFile} download>{t('ui.common.download_cv')}</a>
        </div>
      </aside>
    </div>

    {
      d.diagram === 'mvvm' && (
        <>
          <MvvmArchitecture />
          <MvvmDiagrams />
        </>
      )
    }
  </article>

  <Rail id="more" title={t('ui.case.more')}>
    {others.map((cs) => <PosterCard cs={cs} />)}
  </Rail>
</Base>

<style>
  .cs-hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(2rem, 6vw, 4.5rem));
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .cs-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--color-bg) 0%, transparent 35%),
      linear-gradient(to right, rgb(0 0 0 / 0.45), transparent 70%);
    pointer-events: none;
  }
  .cs-hero-inner { position: relative; z-index: 1; }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.8rem 0.5rem 0.55rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.3);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .back:hover { background: rgb(0 0 0 / 0.45); }
  .back:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .back svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .eyebrow-art {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .badge { padding: 0.2rem 0.45rem; border-radius: 5px; background: rgb(0 0 0 / 0.35); font-weight: 600; }
  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.6rem, 1.6rem + 4.5vw, 5.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
    max-width: 16ch;
  }
  .subtitle { margin-top: 1rem; font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem); opacity: 0.92; max-width: 38rem; }
  .metric {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.55rem 1rem;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.22);
    backdrop-filter: blur(6px);
  }
  .metric strong { font-family: var(--font-display); font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; }

  .cs-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 3rem clamp(2rem, 5vw, 5rem);
    margin-top: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }
  .prose-cs { max-width: 46rem; }
  .lede { font-size: 1.3rem !important; line-height: 1.5; color: var(--color-ink) !important; margin-top: 0 !important; }
  .side {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    padding: 1.5rem;
    border-radius: 16px;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
  }
  dl { display: grid; gap: 1rem; margin: 0; }
  dt { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-faint); }
  dd { margin: 0.2rem 0 0; font-weight: 550; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .side-cta { display: grid; gap: 0.6rem; margin-top: 1.5rem; }
  .side-cta .btn { justify-content: center; }

  @media (max-width: 900px) {
    .cs-body { grid-template-columns: 1fr; }
    .side { position: static; }
  }
</style>
