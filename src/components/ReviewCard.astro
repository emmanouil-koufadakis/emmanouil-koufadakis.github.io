---
import { profile, type Recommendation } from '../data/cv';

interface Props {
  rec: Recommendation;
}
const { rec } = Astro.props;
const initials = rec.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---
<li>
  <a class="review" href={profile.recommendationsUrl} target="_blank" rel="noopener" data-rail-item>
    <figure>
      <svg class="mark" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4.5 1.3 12 0l1.4 3.3C9 4.7 7 7.7 7 11h6v13H0Zm18 0V14c0-8 4.5-12.7 12-14l1.4 3.3C27 4.7 25 7.7 25 11h6v13H18Z" /></svg>
      <blockquote>
        <p>{rec.quote}</p>
      </blockquote>
      <figcaption>
        <span class="avatar art" style={`--h: ${rec.hue}`} aria-hidden="true">{initials}</span>
        <span class="who">
          <strong>{rec.name}</strong>
          <span>{rec.role}</span>
          <span class="rel">{rec.relationship} · {rec.date}</span>
        </span>
      </figcaption>
    </figure>
    <span class="more">Read on LinkedIn<span class="sr-only"> (opens in a new tab)</span> ↗</span>
  </a>
</li>

<style>
  .review {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    width: clamp(280px, 30vw, 400px);
    min-height: 100%;
    padding: 1.5rem;
    border-radius: 16px;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--color-accent) 14%, transparent), transparent 60%),
      var(--color-bg-raised);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
    transition: transform 0.3s var(--ease-out-soft), box-shadow 0.3s var(--ease-out-soft), border-color 0.3s;
  }
  .review:hover { transform: scale(1.02); border-color: color-mix(in oklab, var(--color-accent) 45%, var(--color-line)); }
  .review:focus-visible { outline: none; transform: scale(1.04); box-shadow: var(--focus-ring), var(--focus-glow); }
  figure { margin: 0; display: grid; gap: 1.1rem; }
  .mark { width: 30px; height: 22px; fill: var(--color-accent); }
  blockquote { margin: 0; }
  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.55rem);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  figcaption { display: flex; align-items: center; gap: 0.8rem; }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .who { display: flex; flex-direction: column; gap: 0.05rem; font-size: 0.875rem; color: var(--color-ink-faint); line-height: 1.35; }
  .who strong { color: var(--color-ink); font-size: 0.975rem; font-weight: 650; }
  .rel { font-size: 0.8125rem; }
  .more { font-size: 0.875rem; font-weight: 600; color: var(--color-accent); }
</style>
