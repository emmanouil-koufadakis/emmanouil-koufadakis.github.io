---
import type { CollectionEntry } from 'astro:content';
import { platformStyle } from '../data/cv';
import Shine from './Shine.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const d = entry.data;
---
<li>
  <a href={`/work/${entry.id}/`} class="poster" data-rail-item>
    <div class="art-wrap art" style={`--h: ${d.hue}`}>
      <span class="badge">{platformStyle[d.platform].badge}</span>
      <div class="title-block">
        <span class="period">{d.period}</span>
        <h3>{d.title}</h3>
      </div>
      {
        d.metric && (
          <span class="metric">
            <strong>{d.metric.value}</strong> {d.metric.label}
          </span>
        )
      }
      <Shine />
    </div>
    <p class="sub">{d.subtitle}</p>
  </a>
</li>

<style>
  .poster {
    display: block;
    width: clamp(180px, 16vw, 230px);
    color: var(--color-ink);
    text-decoration: none;
    border-radius: 14px;
  }
  .poster:focus-visible { outline: none; }
  .art-wrap {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: 12px;
    overflow: hidden;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    transition: transform 0.3s var(--ease-out-soft), box-shadow 0.3s var(--ease-out-soft);
  }
  .art-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent 55%);
  }
  .art-wrap > * { position: relative; z-index: 1; }
  .art-wrap > .badge { position: absolute; }
  .badge {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.45rem;
    border-radius: 5px;
    background: rgb(0 0 0 / 0.35);
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  h3 {
    margin-top: 0.3rem;
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.7rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .metric {
    align-self: flex-start;
    font-size: 0.75rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.22);
  }
  .metric strong { font-weight: 750; }
  .sub {
    margin-top: 0.7rem;
    padding-inline: 0.15rem;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--color-ink-faint);
  }
  .poster:hover .art-wrap { transform: scale(1.03); }
  .poster:focus-visible .art-wrap { transform: scale(1.06); box-shadow: var(--focus-ring), var(--focus-glow); }
  .poster:focus-visible .sub { color: var(--color-ink); }
</style>
