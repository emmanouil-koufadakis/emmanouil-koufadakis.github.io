---
import { profile } from '../data/cv';
import { GOATCOUNTER_CODE } from '../data/analytics';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <p class="who">
      <strong>{profile.name}</strong>
      <span>{profile.headline} · {profile.location}</span>
    </p>
    <ul class="links">
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      <li><a href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a></li>
      <li><a href={profile.cvFile} download>Download CV</a></li>
    </ul>
    <p class="fine">
      © {year} {profile.name}. Client names belong to their owners and are shown only to describe my work.
      {GOATCOUNTER_CODE && <> Visits are counted anonymously with <a href="https://www.goatcounter.com" rel="noopener" target="_blank">GoatCounter</a>: no cookies, no personal data.</>}
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-line);
    padding-block: 2.5rem 3rem;
    color: var(--color-ink-faint);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: 1fr auto;
    align-items: center;
  }
  .who { display: flex; flex-direction: column; gap: 0.15rem; }
  .who strong { color: var(--color-ink); font-family: var(--font-display); font-size: 1.05rem; }
  .links { display: flex; gap: 0.25rem 1.25rem; list-style: none; padding: 0; margin: 0; flex-wrap: wrap; }
  .links a { color: var(--color-ink-soft); text-decoration: none; font-weight: 550; border-radius: 4px; }
  .links a:hover { color: var(--color-accent); }
  .fine { grid-column: 1 / -1; font-size: 0.8rem; }
  .fine a { color: inherit; text-underline-offset: 2px; }
  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
