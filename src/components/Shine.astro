---
/**
 * Decorative band of light for cards. Place it as the last child of the
 * card's rectangle (which must be position: relative + overflow: hidden).
 * Styles live in global.css; src/scripts/shine.ts decides when it plays.
 */
interface Props {
  /** Sweep diagonally from bottom-left to top-right instead of left to right. */
  diagonal?: boolean;
}
const { diagonal = false } = Astro.props;
---
<span class:list={['shine', { 'shine-diagonal': diagonal }]} aria-hidden="true"></span>
