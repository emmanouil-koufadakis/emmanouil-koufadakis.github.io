---
import Shine from './Shine.astro';
import { certifications } from '../data/cv';
---
<section id="certifications" class="certs" aria-labelledby="certs-title">
  <div class="wrap">
    <p class="eyebrow">Certifications</p>
    <h2 id="certs-title" class="section-title">Always learning</h2>
    <ul class="grid" data-shine-sequence>
      {
        certifications.map((c) => (
          <li class="card" data-shine-item>
            <div class="seal art" style={`--h: ${c.hue}`} aria-hidden="true">
              <span>{c.issuer}</span>
              <Shine />
            </div>
            <div class="body">
              <h3>{c.name}</h3>
              <p class="meta">
                {c.issuer} · Issued {c.date}
              </p>
              <ul class="topics" aria-label="Topics">
                {c.topics.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
              {c.url && (
                <a class="cred" href={c.url} target="_blank" rel="noopener">
                  View credential
                  <span class="sr-only">
                    {' '}
                    for {c.name} (opens in a new tab)
                  </span>
                  <span aria-hidden="true"> ↗</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .certs { margin-top: clamp(4rem, 8vw, 6rem); scroll-margin-top: calc(var(--nav-h) + 16px); }
  .section-title { margin-top: 0.5rem; }
  .grid {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
  }
  .seal {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 5;
    display: grid;
    place-items: center;
  }
  .seal::before { content: ''; position: absolute; inset: 0; background: rgb(0 0 0 / 0.18); }
  .seal span {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem 1.3rem 1.35rem;
  }
  h3 { font-size: 1.1rem; font-weight: 700; line-height: 1.3; }
  .meta { color: var(--color-ink-faint); font-size: 0.9375rem; }
  .topics { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.35rem 0 0; padding: 0; list-style: none; }
  .cred {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.6rem;
    color: var(--color-accent);
    font-weight: 650;
    text-decoration: none;
    border-radius: 4px;
  }
  .cred:hover { text-decoration: underline; text-underline-offset: 3px; }
  .cred:focus-visible { outline: none; box-shadow: var(--focus-ring); }
</style>

<script>
  import { initShine } from '../scripts/shine';
  initShine();
</script>
