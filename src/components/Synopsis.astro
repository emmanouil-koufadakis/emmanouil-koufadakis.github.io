---
import { getContent } from '../data/content';
const { certifications, education, languages, profile, volunteering, t } = getContent(Astro.currentLocale);
---
<section id="about" class="synopsis" aria-labelledby="about-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">{t('ui.synopsis.eyebrow')}</p>
      <h2 id="about-title" class="section-title">{t('ui.synopsis.title')}</h2>
      {profile.about.map((p) => <p class="para">{p}</p>)}
    </div>
    <aside class="facts" aria-label={t('ui.synopsis.facts_label')}>
      <div class="block">
        <h3 class="eyebrow">{t('ui.synopsis.education')}</h3>
        <ul>
          {
            education.map((e) => (
              <li>
                <strong>{e.degree}</strong>
                <span>
                  {e.school} · {e.year}
                  {e.detail && ` · ${e.detail}`}
                </span>
                {e.dissertation && <span class="diss">{t('ui.common.dissertation')} {e.dissertation}</span>}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="block">
        <h3 class="eyebrow">{t('ui.certs.eyebrow')}</h3>
        <a class="jump" href="#certifications">
          {t('ui.synopsis.cert_jump', { count: certifications.length })} <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="block">
        <h3 class="eyebrow">{t('ui.synopsis.languages')}</h3>
        <ul class="langs">
          {
            languages.map((l) => (
              <li>
                <strong>{l.name}</strong>
                <span>{l.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="block">
        <h3 class="eyebrow">{t('ui.synopsis.volunteering')}</h3>
        <ul>
          {
            volunteering.map((v) => (
              <li>
                <strong>{v.role}</strong>
                <span>
                  {v.org} · {v.year}
                </span>
                <span class="diss">{v.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .synopsis { margin-top: clamp(4rem, 8vw, 6rem); }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .section-title { margin-top: 0.5rem; margin-bottom: 1.25rem; }
  .para { font-size: 1.125rem; color: var(--color-ink-soft); max-width: 44rem; }
  .para + .para { margin-top: 1rem; }
  .facts {
    display: grid;
    gap: 1.75rem;
    padding: 1.5rem;
    border-radius: 16px;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
  }
  .block ul { margin: 0.85rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.9rem; }
  .block li { display: flex; flex-direction: column; gap: 0.1rem; }
  .block strong { font-weight: 650; }
  .block span { color: var(--color-ink-faint); font-size: 0.9375rem; }
  .langs { grid-template-columns: 1fr 1fr; }
  .block .diss { font-size: 0.875rem; font-style: italic; }
  .jump {
    display: inline-block;
    margin-top: 0.6rem;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
  }
  .jump:hover { text-decoration: underline; text-underline-offset: 3px; }
  .jump:focus-visible { outline: none; box-shadow: var(--focus-ring); }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
