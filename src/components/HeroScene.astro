---
import { getContent } from '../data/content';
const { t } = getContent(Astro.currentLocale);
/**
 * Hero artwork inspired by the LinkedIn cover: an indigo "engineering" scene
 * with circuit traces, floating code / flowchart windows and a grid of the
 * platforms Manos builds for. Tiles are styled text, not official logos.
 * Purely decorative (aria-hidden on the wrapper in Hero.astro).
 */
const tiles = [
  { label: 'Roku', cls: 'roku' },
  { label: 'JS', cls: 'js' },
  { label: 'C#', cls: 'cs' },
  { label: 'Xbox', cls: 'xbox' },
  { label: 'PlayStation', cls: 'ps' },
  { label: 'Windows', cls: 'windows' },
];
---
<div class="scene">
  <svg class="circuit" viewBox="0 0 800 900" preserveAspectRatio="xMidYMid slice">
    <g fill="none" stroke-width="1.4">
      <path d="M800 120H640l-40 40H470" />
      <path d="M800 210H700l-30 30v90l-40 40H540" />
      <path d="M800 470H690l-50-50H560l-30 30" />
      <path d="M800 560H720l-40 40v120l40 40h80" />
      <path d="M800 690H600l-60 60v150" />
      <path d="M650 900V800l40-40h110" />
      <path d="M470 900V820l-40-40H300" />
      <path d="M560 0v60l40 40h200" />
      <path d="M380 0v40l-30 30H180" />
      <path d="M0 640h120l40 40h140l40-40h60" />
    </g>
    <g class="nodes">
      <circle cx="470" cy="160" r="4" /><circle cx="540" cy="370" r="4" /><circle cx="530" cy="450" r="4" />
      <circle cx="800" cy="760" r="4" /><circle cx="540" cy="900" r="4" /><circle cx="300" cy="780" r="4" />
      <circle cx="180" cy="70" r="4" /><circle cx="400" cy="640" r="4" /><circle cx="690" cy="760" r="4" />
    </g>
  </svg>
  <div class="glow" />

  <div class="win w-code">
    <div class="bar"><i /><i /><i /><span>HomeScene.brs</span></div>
    <pre><span class="k">sub</span> init()
  m.rail = m.top.findNode(<span class="s">"rail"</span>)
  m.rail.observeField(<span class="s">"itemFocused"</span>, <span class="s">"onFocus"</span>)
  m.top.setFocus(<span class="k">true</span>)
<span class="k">end sub</span></pre>
  </div>

  <div class="win w-flow">
    <div class="bar"><i /><i /><i /><span>MVVM</span></div>
    <svg viewBox="0 0 200 120">
      <g class="fc">
        <rect x="6" y="10" width="56" height="24" rx="4" /><text x="34" y="26">View</text>
        <rect x="72" y="10" width="76" height="24" rx="4" /><text x="110" y="26">ViewModel</text>
        <rect x="72" y="74" width="76" height="24" rx="4" /><text x="110" y="90">Model</text>
        <path d="M168 54l16 12-16 12-16-12z" />
        <path class="ar" d="M62 22h10M110 34v40M148 86h20V78M168 54V22h-20" />
      </g>
    </svg>
  </div>

  <div class="win w-lines">
    <div class="bar"><i /><i /><i /><span>PageViewModel.bs</span></div>
    <pre><span class="k">function</span> load(id <span class="k">as</span> String)
  vm = PageViewModel(id)
  vm.fetch() <span class="c">' task thread</span>
<span class="k">end function</span></pre>
  </div>

  <p class="label">{t('ui.hero.scene_label')}</p>
  <ul class="tiles">
    {tiles.map((t) => <li class={t.cls}><span>{t.label}</span></li>)}
  </ul>
</div>

<style>
  .scene {
    --ink: light-dark(oklch(0.3 0.08 280), oklch(0.9 0.05 240));
    --edge: light-dark(oklch(0.55 0.18 290 / 0.55), oklch(0.82 0.11 225 / 0.6));
    --edge-glow: light-dark(oklch(0.6 0.18 290 / 0.25), oklch(0.75 0.14 230 / 0.45));
    --panel: light-dark(rgb(255 255 255 / 0.55), rgb(110 140 255 / 0.08));
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(55% 60% at 22% 55%, light-dark(oklch(0.8 0.12 300 / 0.55), oklch(0.5 0.2 305 / 0.55)), transparent 70%),
      radial-gradient(50% 50% at 90% 20%, light-dark(oklch(0.85 0.08 260 / 0.6), oklch(0.36 0.14 270 / 0.7)), transparent 70%),
      linear-gradient(120deg, light-dark(oklch(0.93 0.04 295), oklch(0.27 0.11 295)) 0%, light-dark(oklch(0.95 0.03 270), oklch(0.2 0.08 275)) 100%);
  }

  .circuit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .circuit g { stroke: light-dark(oklch(0.55 0.15 285 / 0.28), oklch(0.75 0.12 235 / 0.28)); }
  .circuit .nodes { fill: light-dark(oklch(0.55 0.15 285 / 0.45), oklch(0.8 0.12 230 / 0.6)); stroke: none; }
  .glow {
    position: absolute;
    left: 30%;
    top: 30%;
    width: 50%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, light-dark(oklch(0.85 0.1 300 / 0.5), oklch(0.6 0.2 300 / 0.35)), transparent 65%);
    filter: blur(20px);
  }

  /* ---------- floating windows ---------- */
  .win {
    position: absolute;
    border-radius: 10px;
    border: 1px solid var(--edge);
    background: var(--panel);
    box-shadow: 0 0 28px var(--edge-glow), inset 0 0 18px var(--edge-glow);
    backdrop-filter: blur(3px);
    color: var(--ink);
    font-family: var(--font-mono);
    animation: float 9s ease-in-out infinite;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 7px 10px;
    border-bottom: 1px solid var(--edge);
    font-size: 10px;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }
  .bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--edge); }
  .bar span { margin-left: 6px; }
  pre {
    margin: 0;
    padding: 10px 12px 12px;
    font-size: clamp(9.5px, 0.78vw, 11.5px);
    line-height: 1.6;
    white-space: pre;
  }
  .k { color: light-dark(oklch(0.5 0.2 300), oklch(0.8 0.14 300)); }
  .s { color: light-dark(oklch(0.5 0.14 160), oklch(0.82 0.13 165)); }
  .c { opacity: 0.6; }

  .w-code { left: 17%; top: 16%; }
  .w-flow { left: 30%; top: 47%; width: clamp(170px, 15vw, 220px); animation-delay: -3s; }
  .w-lines { left: 15%; top: 70%; animation-delay: -6s; }

  .w-flow svg { display: block; width: 100%; height: auto; padding: 8px 10px 10px; }
  .fc rect, .fc path { fill: none; stroke: var(--edge); stroke-width: 1.3; }
  .fc .ar { stroke-dasharray: 3 3; }
  .fc text { fill: var(--ink); font-size: 9px; text-anchor: middle; font-family: var(--font-mono); }

  /* ---------- platform tiles ---------- */
  .label {
    position: absolute;
    right: 8%;
    top: 14%;
    font-size: clamp(14px, 1.25vw, 19px);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: light-dark(oklch(0.4 0.12 280), oklch(0.85 0.08 230));
  }
  .tiles {
    --t: clamp(58px, 5.8vw, 92px);
    position: absolute;
    right: 8%;
    top: calc(14% + 2.2rem);
    display: grid;
    grid-template-columns: repeat(3, var(--t));
    gap: calc(var(--t) * 0.18);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tiles li {
    width: var(--t);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: calc(var(--t) * 0.16);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    box-shadow: 0 14px 30px -12px rgb(0 0 0 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.2);
  }
  .tiles span { line-height: 1; text-align: center; }
  .roku { background: oklch(0.42 0.17 303); font-size: calc(var(--t) * 0.28); }
  .js {
    background: oklch(0.9 0.17 100);
    color: #1d1b16 !important;
    font-size: calc(var(--t) * 0.36);
    place-items: end !important;
    padding: calc(var(--t) * 0.1);
  }
  .cs {
    background: linear-gradient(160deg, oklch(0.62 0.2 300), oklch(0.42 0.2 295));
    clip-path: polygon(50% 0, 95% 25%, 95% 75%, 50% 100%, 5% 75%, 5% 25%);
    border-radius: 0 !important;
    font-size: calc(var(--t) * 0.34);
  }
  .xbox { background: oklch(0.55 0.17 145); font-size: calc(var(--t) * 0.24); border-radius: 50% !important; }
  .ps { background: oklch(0.42 0.16 262); font-size: calc(var(--t) * 0.15); }
  .windows { background: oklch(0.56 0.15 242); font-size: calc(var(--t) * 0.17); }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* Narrower desktops: fewer windows, so nothing crowds the headline or buttons. */
  @media (max-width: 1320px) {
    .w-lines { display: none; }
  }
  @media (max-width: 1120px) and (min-width: 901px) {
    .w-code { display: none; }
    .w-flow { left: 24%; top: 30%; }
  }

  /* ---------- phones / small tablets: label and tiles centred, no windows ---------- */
  @media (max-width: 900px) {
    .win { display: none; }
    .label { right: auto; left: 50%; translate: -50% 0; top: 24%; white-space: nowrap; }
    .tiles {
      --t: clamp(52px, 15vw, 76px);
      right: auto;
      left: 50%;
      translate: -50% 0;
      top: calc(24% + 2.2rem);
    }
  }
</style>
