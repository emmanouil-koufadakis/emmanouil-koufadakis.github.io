  .canvas :global(.um-base .um-box) { stroke: color-mix(in oklab, var(--color-accent) 50%, var(--color-line)); }
  .canvas :global(.um-base .um-band) { fill: color-mix(in oklab, var(--color-accent) 16%, transparent); }
  .canvas :global(.um-app .um-box) { stroke: color-mix(in oklab, oklch(0.62 0.13 175) 60%, var(--color-line)); }
  .canvas :global(.um-app .um-band) { fill: color-mix(in oklab, oklch(0.62 0.13 175) 16%, transparent); }
  .canvas :global(.um-sep) { stroke: var(--color-line); }
  .canvas :global(.um-name) { font-size: 10.5px; font-weight: 700; fill: var(--color-ink); }
  .canvas :global(.um-stereo) { font-size: 9px; fill: var(--color-ink-faint); }
  .canvas :global(.um-member) { font-size: 10px; fill: var(--color-ink-soft); }
  .canvas :global(.um-method) { fill: var(--color-ink); }

  /* ---------- keys ---------- */
  .key { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0.9rem 0 0; padding: 0; list-style: none; font-size: 0.8125rem; color: var(--color-ink-soft); }
