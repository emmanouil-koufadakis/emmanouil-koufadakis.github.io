  .k-box { width: 22px; height: 14px; border-radius: 4px; border: 1.2px solid; background: var(--color-bg); }
  .k-sg { border-style: dashed; border-color: color-mix(in oklab, var(--color-ink) 30%, transparent); background: transparent; }
  .k-base { border-color: color-mix(in oklab, var(--color-accent) 50%, var(--color-line)); box-shadow: inset 0 5px 0 color-mix(in oklab, var(--color-accent) 16%, transparent); }
  .k-app { border-color: color-mix(in oklab, oklch(0.62 0.13 175) 60%, var(--color-line)); box-shadow: inset 0 5px 0 color-mix(in oklab, oklch(0.62 0.13 175) 16%, transparent); }
</style>

<script>
  // Tabs: show one diagram at a time. Without JavaScript both stay visible.
  for (const root of document.querySelectorAll<HTMLElement>('[data-diagrams]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const select = (id: string, focus = false) => {
      for (const t of tabs) {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      }
      for (const p of panels) p.hidden = p.dataset.panel !== id;
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(next.dataset.tab!, true);
      });
    });
    select('seq');
  }
</script>
