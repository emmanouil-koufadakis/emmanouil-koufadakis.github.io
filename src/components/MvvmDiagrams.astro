  }
  .canvas :global(.um-box) { fill: var(--color-bg); stroke-width: 1.2; }
  .canvas :global(.um-sg) { fill: transparent; stroke: color-mix(in oklab, var(--color-ink) 30%, transparent); stroke-dasharray: 4 3; }
