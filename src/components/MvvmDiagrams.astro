  }
  .tab:hover { color: var(--color-ink); background: color-mix(in oklab, var(--color-ink) 12%, transparent); }
  .tab:focus-visible { outline: none; box-shadow: var(--focus-ring); }
  .tab[aria-selected='true'] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); }
  .kind { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.75; }

  /* ---------- panels ---------- */
  .panel {
    margin-top: 1rem;
    padding: clamp(0.75rem, 1.6vw, 1.25rem);
    border-radius: 18px;
    border: 1px solid var(--color-line);
    background:
      radial-gradient(90% 60% at 0% 0%, color-mix(in oklab, var(--color-accent) 9%, transparent), transparent 60%),
      var(--color-bg-raised);
  }
  .swipe { display: none; margin: 0 0 0.6rem; font-size: 0.8125rem; color: var(--color-ink-faint); }
  @media (max-width: 1040px) { .swipe { display: block; } }
  .scroller { overflow-x: auto; overscroll-behavior-x: contain; border-radius: 12px; }
  .scroller:focus-visible { outline: none; box-shadow: var(--focus-ring); }
  .canvas { min-width: 980px; }
  .canvas-uml { min-width: 1060px; }
  .canvas :global(.dg-svg) { display: block; width: 100%; height: auto; }

  /* ---------- shared SVG text ---------- */
  .canvas :global(text) { font-family: var(--font-mono); }

  /* ---------- sequence diagram ---------- */
  .canvas :global(.sq-head) { fill: var(--color-bg); stroke: color-mix(in oklab, var(--color-accent) 45%, var(--color-line)); stroke-width: 1.2; }
  .canvas :global(.sq-name) { font-family: var(--font-display); font-size: 12px; font-weight: 700; fill: var(--color-ink); }
  .canvas :global(.sq-type) { font-size: 9.5px; fill: var(--color-ink-faint); }
  .canvas :global(.sq-life) { stroke: color-mix(in oklab, var(--color-ink) 22%, transparent); stroke-width: 1.2; stroke-dasharray: 4 5; }
  .canvas :global(.sq-thread) { fill: color-mix(in oklab, oklch(0.62 0.13 200) 12%, transparent); stroke: color-mix(in oklab, oklch(0.62 0.13 200) 35%, transparent); stroke-dasharray: 3 4; }
  .canvas :global(.sq-line) { fill: none; stroke: var(--color-ink-soft); stroke-width: 1.5; }
  .canvas :global(.sq-return) { stroke-dasharray: 5 4; stroke: var(--color-ink-faint); }
  .canvas :global(.sq-mk-fill) { fill: var(--color-ink-soft); }
  .canvas :global(.sq-mk-open) { fill: none; stroke: var(--color-ink-soft); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .canvas :global(.sq-label) {
    font-size: 10.5px;
    fill: var(--color-ink);
    paint-order: stroke;
    stroke: var(--color-bg-raised);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .canvas :global(.sq-num) { fill: var(--color-accent); font-weight: 700; }
