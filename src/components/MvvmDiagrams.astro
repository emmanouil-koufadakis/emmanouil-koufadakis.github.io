---
/**
 * Two UML views of the custom Roku MVVM framework, drawn as SVG at build time:
 * 1. Sequence diagram: what happens, in order, when the user opens a screen.
 * 2. Class diagram: how the base classes extend SceneGraph nodes and how an
 *    example screen's classes depend on each other.
 * Order of calls and class members follow the framework's own code.
 */
import { getContent } from '../data/content';
const { t } = getContent(Astro.currentLocale);

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const r1 = (n: number) => Math.round(n * 10) / 10;

/* =====================================================================
   1. Sequence diagram
   ===================================================================== */

const participants = [
  { id: 'user', name: t('seq.p.user.name').split('\n'), type: t('seq.p.user.type') },
  { id: 'menu', name: t('seq.p.menu.name').split('\n'), type: t('seq.p.menu.type') },
  { id: 'scene', name: t('seq.p.scene.name').split('\n'), type: t('seq.p.scene.type') },
  { id: 'nav', name: t('seq.p.nav.name').split('\n'), type: t('seq.p.nav.type') },
  { id: 'vm', name: t('seq.p.vm.name').split('\n'), type: t('seq.p.vm.type') },
  { id: 'view', name: t('seq.p.view.name').split('\n'), type: t('seq.p.view.type') },
  { id: 'model', name: t('seq.p.model.name').split('\n'), type: t('seq.p.model.type') },
  { id: 'repo', name: t('seq.p.repo.name').split('\n'), type: t('seq.p.repo.type') },
  { id: 'focus', name: t('seq.p.focus.name').split('\n'), type: t('seq.p.focus.type') },
];

type Msg =
  | { from: string; to: string; label: string; kind: 'call' | 'async' | 'return' }
  | { self: string; label: string }
  | { divider: string };

const messages: Msg[] = [
  { from: 'user', to: 'menu', label: t('seq.msg.1'), kind: 'call' },
  { from: 'menu', to: 'scene', label: t('seq.msg.2'), kind: 'call' },
  { from: 'scene', to: 'nav', label: t('seq.msg.3'), kind: 'call' },
  { self: 'nav', label: t('seq.msg.4') },
  { from: 'nav', to: 'scene', label: t('seq.msg.5'), kind: 'return' },
  { from: 'scene', to: 'vm', label: t('seq.msg.6'), kind: 'call' },
  { self: 'vm', label: t('seq.msg.7') },
  { from: 'vm', to: 'view', label: t('seq.msg.8'), kind: 'call' },
  { from: 'view', to: 'model', label: t('seq.msg.9'), kind: 'call' },
  { from: 'view', to: 'model', label: t('seq.msg.10'), kind: 'call' },
  { from: 'view', to: 'model', label: t('seq.msg.11'), kind: 'call' },
  { from: 'model', to: 'view', label: t('seq.msg.12'), kind: 'return' },
  { from: 'model', to: 'repo', label: t('seq.msg.13'), kind: 'call' },
  { from: 'model', to: 'repo', label: t('seq.msg.14'), kind: 'call' },
  { from: 'model', to: 'repo', label: t('seq.msg.15'), kind: 'async' },
  { from: 'vm', to: 'view', label: t('seq.msg.16'), kind: 'call' },
  { self: 'vm', label: t('seq.msg.17') },
  { from: 'vm', to: 'focus', label: t('seq.msg.18'), kind: 'call' },
  { from: 'focus', to: 'view', label: t('seq.msg.19'), kind: 'return' },
  { from: 'vm', to: 'view', label: t('seq.msg.20'), kind: 'call' },
  { from: 'vm', to: 'scene', label: t('seq.msg.21'), kind: 'return' },
  { self: 'scene', label: t('seq.msg.22') },
  { divider: t('seq.divider') },
  { self: 'repo', label: t('seq.msg.23') },
  { self: 'repo', label: t('seq.msg.24') },
  { from: 'repo', to: 'model', label: t('seq.msg.25'), kind: 'return' },
  { self: 'model', label: t('seq.msg.26') },
  { from: 'model', to: 'view', label: t('seq.msg.27'), kind: 'return' },
  { self: 'view', label: t('seq.msg.28') },
  { from: 'view', to: 'focus', label: t('seq.msg.29'), kind: 'call' },
  { from: 'model', to: 'view', label: t('seq.msg.30'), kind: 'return' },
];

const SW = 1080;
const SPAD = 16;
const colW = (SW - SPAD * 2) / participants.length;
const pIndex = Object.fromEntries(participants.map((p, i) => [p.id, i]));
const px = (id: string) => SPAD + colW * (pIndex[id] + 0.5);
const headTop = 8;
const headH = 58;
const lifeTop = headTop + headH;

const seq: string[] = [];
let y = lifeTop + 36;
let n = 0;
for (const m of messages) {
  if ('divider' in m) {
    y += 6;
    seq.push(`<line class="sq-divider" x1="${SPAD}" y1="${y}" x2="${SW - SPAD}" y2="${y}"/>`);
    const w = m.divider.length * 6.4 + 28;
    seq.push(`<rect class="sq-pill" x="${r1(SW / 2 - w / 2)}" y="${y - 11}" width="${r1(w)}" height="22" rx="11"/>`);
    seq.push(`<text class="sq-pill-text" x="${SW / 2}" y="${y + 4}" text-anchor="middle">${esc(m.divider)}</text>`);
    y += 40;
    continue;
  }
  n += 1;
  const num = `<tspan class="sq-num">${n}</tspan>`;
  if ('self' in m) {
    const x = px(m.self);
    const dir = x > SW - 220 ? -1 : 1; // loop to the left near the right edge
    seq.push(`<path class="sq-line" d="M${r1(x)} ${y} h${26 * dir} v14 h${-26 * dir}" marker-end="url(#sq-solid)"/>`);
    seq.push(`<text class="sq-label" x="${r1(x + 34 * dir)}" y="${y + 11}" text-anchor="${dir > 0 ? 'start' : 'end'}">${num}  ${esc(m.label)}</text>`);
    y += 40;
  } else {
    const x1 = px(m.from);
    const x2 = px(m.to);
    const cls = m.kind === 'return' ? 'sq-line sq-return' : 'sq-line';
    const marker = m.kind === 'call' ? 'sq-solid' : 'sq-open';
    const inset = x2 > x1 ? -3 : 3;
    seq.push(`<line class="${cls}" x1="${r1(x1)}" y1="${y}" x2="${r1(x2 + inset)}" y2="${y}" marker-end="url(#${marker})"/>`);
    seq.push(`<text class="sq-label" x="${r1((x1 + x2) / 2)}" y="${y - 7}" text-anchor="middle">${num}  ${esc(m.label)}</text>`);
    y += 32;
  }
}
const SH = y + 8;

const seqHead: string[] = [];
// Shaded column: the Repository works on its own Task thread.
const rx = px('repo');
seqHead.push(`<rect class="sq-thread" x="${r1(rx - colW / 2 + 5)}" y="${headTop}" width="${r1(colW - 10)}" height="${SH - headTop - 2}" rx="10"/>`);
for (const p of participants) {
  const x = px(p.id);
  seqHead.push(`<line class="sq-life" x1="${r1(x)}" y1="${lifeTop}" x2="${r1(x)}" y2="${SH - 6}"/>`);
  seqHead.push(`<rect class="sq-head" x="${r1(x - colW / 2 + 9)}" y="${headTop}" width="${r1(colW - 18)}" height="${headH}" rx="10"/>`);
  const nameY = p.name.length === 2 ? headTop + 19 : headTop + 25;
  p.name.forEach((line, i) => seqHead.push(`<text class="sq-name" x="${r1(x)}" y="${nameY + i * 14}" text-anchor="middle">${esc(line)}</text>`));
  seqHead.push(`<text class="sq-type" x="${r1(x)}" y="${headTop + headH - 10}" text-anchor="middle">${esc(p.type)}</text>`);
}

const seqSvg = `<svg viewBox="0 0 ${SW} ${SH}" role="img" aria-labelledby="sq-title sq-desc" class="dg-svg">
<title id="sq-title">${esc(t('seq.svg_title'))}</title>
<desc id="sq-desc">${esc(t('seq.svg_desc'))}</desc>
<defs>
  <marker id="sq-solid" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path class="sq-mk-fill" d="M0 0 10 5 0 10z"/></marker>
  <marker id="sq-open" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse"><path class="sq-mk-open" d="M1 1 9 5 1 9"/></marker>
</defs>
${seqHead.join('\n')}
${seq.join('\n')}
</svg>`;

/* =====================================================================
   2. Class diagram
   ===================================================================== */

type Kind = 'sg' | 'base' | 'app';
interface Box {
  id: string;
  name: string;
  kind: Kind;
  c: number;
  r: number;
  stereo?: string;
  fields?: string[];
  methods?: string[];
}

const boxes: Box[] = [
  // SceneGraph built-in nodes
  { id: 'Scene', name: 'Scene', kind: 'sg', c: 0, r: 0 },
  { id: 'Group', name: 'Group', kind: 'sg', c: 1, r: 0 },
  { id: 'Node', name: 'Node', kind: 'sg', c: 3, r: 0 },
  { id: 'Task', name: 'Task', kind: 'sg', c: 4, r: 0 },
  { id: 'ContentNode', name: 'ContentNode', kind: 'sg', c: 5, r: 0 },
  // Framework base classes
  { id: 'BaseAppScene', name: 'BaseAppScene', kind: 'base', c: 0, r: 1, fields: ['navigationEvent'], methods: ['forward(path, args)', 'back(args)', 'backTo(path)', 'sideways(path)', 'reload()'] },
  { id: 'BaseGroup', name: 'BaseGroup', kind: 'base', c: 1, r: 1, fields: ['isFocused', 'isChildFocused', 'isInitialFocus'], methods: ['_onGainedFocus(args)', '_getDefaultFocusable()', 'deinit()'] },
  { id: 'FocusManager', name: 'FocusManager', kind: 'base', c: 2, r: 1, stereo: t('uml.stereo.global'), fields: ['focusedNode', 'isLocked'], methods: ['setFocusOn(node)', 'setFocusLocked(node)'] },
  { id: 'BaseViewModel', name: 'BaseViewModel', kind: 'base', c: 3, r: 1, fields: ['isAlive', 'isLoadingData'], methods: ['_setLoadingState()', '_updateAndTrackRepo()', 'deinit()'] },
  { id: 'BaseRepository', name: 'BaseRepository', kind: 'base', c: 4, r: 1, methods: ['handleRequest(endpoint)', 'buildCommonHeaders()', 'deinit()'] },
  { id: 'BaseModel', name: 'BaseModel', kind: 'base', c: 5, r: 1, fields: ['type'], methods: ['deinit()'] },
  { id: 'NavigationManager', name: 'NavigationManager', kind: 'base', c: 0, r: 2, stereo: t('uml.stereo.object'), fields: ['_history', '_menuData'], methods: ['forward(path)', 'back()', 'backTo(path)', 'getHistory()'] },
  { id: 'BaseView', name: 'BaseView', kind: 'base', c: 1, r: 2, fields: ['isInStack', 'viewArgs'], methods: ['onInit(args)', 'onReady(args)', 'onBack(args)', 'onReload(args)', 'onLeaving()', 'hasContent()'] },
  { id: 'FocusGroup', name: 'FocusGroup', kind: 'base', c: 2, r: 2, fields: ['focusDirection', 'scrollDirection'], methods: ['updateFocusedIndex(i)', 'onKeyEvent(key, press)'] },
  { id: 'ViewManager', name: 'ViewManager', kind: 'base', c: 0, r: 3, stereo: t('uml.stereo.object'), fields: ['_viewDefinitions'], methods: ['forward(path, args)', 'back(args)', 'getTopView()'] },
  // Example screen
  { id: 'HomeView', name: 'HomeView', kind: 'app', c: 1, r: 3, stereo: t('uml.stereo.example_view'), methods: ['_loadData()', '_getDefaultFocusable()'] },
  { id: 'CollectionVM', name: 'CollectionViewViewModel', kind: 'app', c: 3, r: 3, stereo: t('uml.stereo.example_view_model'), fields: ['content', 'error'], methods: ['getContent(path)'] },
  { id: 'CollectionRepo', name: 'CollectionDataRepository', kind: 'app', c: 4, r: 3, stereo: t('uml.stereo.example_repository'), fields: ['content', 'error'], methods: ['getContent()'] },
  { id: 'CollectionModel', name: 'CollectionModel', kind: 'app', c: 5, r: 3, stereo: t('uml.stereo.example_model'), fields: ['title', 'page', 'total', 'template'] },
  { id: 'CollectionService', name: 'CollectionService', kind: 'app', c: 4, r: 4, stereo: t('uml.stereo.functions'), methods: ['parseCollectionData(data)'] },
];

const UW = 1300;
const UM = 16;
const BW = 168;
const GX = 52;
const LH = 14;
const colX = (c: number) => UM + c * (BW + GX);
const headOf = (b: Box) => (b.kind === 'sg' ? 28 : b.stereo ? 38 : 27);
const heightOf = (b: Box) => {
  if (b.kind === 'sg') return 28;
  const f = b.fields?.length ? b.fields.length * LH + 9 : 0;
  const m = b.methods?.length ? b.methods.length * LH + 9 : 0;
  return headOf(b) + f + m + 3;
};
const rows = Math.max(...boxes.map((b) => b.r)) + 1;
const rowH = Array.from({ length: rows }, (_, r) => Math.max(...boxes.filter((b) => b.r === r).map(heightOf)));
const GY = [0, 40, 46, 46, 46];
const rowTop: number[] = [];
let acc = UM;
for (let r = 0; r < rows; r++) {
  acc += GY[r] ?? 46;
  if (r === 0) acc = UM;
  rowTop.push(acc);
  acc += rowH[r];
}
const UH = acc + UM;
const rowBottom = (r: number) => rowTop[r] + rowH[r];

const geo = Object.fromEntries(
  boxes.map((b) => {
    const x = colX(b.c);
    const top = rowTop[b.r];
    const h = heightOf(b);
    return [b.id, { x, top, w: BW, h, cx: x + BW / 2, bottom: top + h, midY: top + Math.min(headOf(b), 28) / 2 + (b.stereo ? 6 : 0), r: b.r }];
  }),
);

const uml: string[] = [];
const umlLabels: string[] = [];
const label = (x: number, yy: number, text: string, anchor = 'middle') =>
  umlLabels.push(`<text class="um-elabel" x="${r1(x)}" y="${r1(yy)}" text-anchor="${anchor}">${esc(text)}</text>`);

// Inheritance: child → parent, hollow triangle at the parent.
const extendsEdges: [string, string][] = [
  ['BaseAppScene', 'Scene'],
  ['BaseGroup', 'Group'],
  ['FocusManager', 'Group'],
  ['BaseView', 'BaseGroup'],
  ['FocusGroup', 'BaseGroup'],
  ['HomeView', 'BaseView'],
  ['BaseViewModel', 'Node'],
  ['CollectionVM', 'BaseViewModel'],
  ['BaseRepository', 'Task'],
  ['CollectionRepo', 'BaseRepository'],
  ['BaseModel', 'ContentNode'],
  ['CollectionModel', 'BaseModel'],
];
for (const [child, parent] of extendsEdges) {
  const c = geo[child];
  const p = geo[parent];
  if (Math.abs(c.cx - p.cx) < 1) {
    uml.push(`<path class="um-edge" d="M${c.cx} ${c.top} V${p.bottom + 1}" marker-end="url(#um-extends)"/>`);
  } else {
    const mid = rowBottom(c.r - 1) + (GY[c.r] ?? 46) / 2;
    uml.push(`<path class="um-edge" d="M${c.cx} ${c.top} V${mid} H${p.cx} V${p.bottom + 1}" marker-end="url(#um-extends)"/>`);
  }
}

// Composition: owner ◆—— part.
{
  const s = geo.BaseAppScene;
  const nm = geo.NavigationManager;
  uml.push(`<path class="um-edge" d="M${s.cx} ${s.bottom} V${nm.top}" marker-start="url(#um-owns)"/>`);
  const vm = geo.ViewManager;
  uml.push(`<path class="um-edge" d="M${s.x} ${s.midY} H${UM / 2 - 2} V${vm.midY} H${vm.x}" marker-start="url(#um-owns)"/>`);
  label(s.cx + 6, s.bottom + 26, t('uml.edge.owns'), 'start');

  const hv = geo.HomeView;
  const cvm = geo.CollectionVM;
  uml.push(`<path class="um-edge" d="M${hv.x + hv.w} ${hv.midY} H${cvm.x - 1}" marker-start="url(#um-owns)" marker-end="url(#um-open)"/>`);
  label((hv.x + hv.w + cvm.x) / 2, hv.midY - 7, t('uml.edge.owns_one'));
}

// Dependencies: dashed, open arrow.
const dep = (d: string, lx: number, ly: number, text: string, anchor = 'middle') => {
  uml.push(`<path class="um-edge um-dep" d="${d}" marker-end="url(#um-open)"/>`);
  label(lx, ly, text, anchor);
};
{
  const a = geo.ViewManager;
  const b = geo.HomeView;
  dep(`M${a.x + a.w} ${b.midY} H${b.x - 1}`, (a.x + a.w + b.x) / 2, b.midY - 7, t('uml.edge.creates'));
}
{
  const a = geo.BaseGroup;
  const b = geo.FocusManager;
  dep(`M${a.x + a.w} ${a.midY} H${b.x - 1}`, (a.x + a.w + b.x) / 2, a.midY - 7, t('uml.edge.set_focus'));
}
{
  const a = geo.CollectionVM;
  const b = geo.CollectionRepo;
  dep(`M${a.x + a.w} ${a.midY} H${b.x - 1}`, (a.x + a.w + b.x) / 2, a.midY - 7, t('uml.edge.runs'));
}
{
  const a = geo.CollectionRepo;
  const b = geo.CollectionService;
  dep(`M${a.cx + 30} ${a.bottom} V${b.top - 1}`, a.cx + 36, (a.bottom + b.top) / 2 + 4, t('uml.edge.parses_with'), 'start');
}
{
  const a = geo.CollectionService;
  const b = geo.CollectionModel;
  dep(`M${a.x + a.w} ${a.midY} H${b.cx} V${b.bottom + 1}`, (a.x + a.w + b.cx) / 2, a.midY - 7, t('uml.edge.creates'));
}

// Boxes on top of the edges.
for (const b of boxes) {
  const g = geo[b.id];
  if (b.kind === 'sg') {
    uml.push(`<rect class="um-box um-sg" x="${g.x}" y="${g.top}" width="${g.w}" height="${g.h}" rx="8"/>`);
    uml.push(`<text class="um-sg-name" x="${g.cx}" y="${g.top + 18}" text-anchor="middle">${esc(b.name)}</text>`);
    continue;
  }
  const hh = headOf(b);
  uml.push(`<g class="um-${b.kind}">`);
  uml.push(`<rect class="um-box" x="${g.x}" y="${g.top}" width="${g.w}" height="${g.h}" rx="9"/>`);
  uml.push(`<path class="um-band" d="M${g.x} ${g.top + 9} a9 9 0 0 1 9 -9 h${g.w - 18} a9 9 0 0 1 9 9 v${hh - 9} h${-g.w} z"/>`);
  if (b.stereo) uml.push(`<text class="um-stereo" x="${g.cx}" y="${g.top + 14}" text-anchor="middle">«${esc(b.stereo)}»</text>`);
  uml.push(`<text class="um-name" x="${g.cx}" y="${g.top + (b.stereo ? 29 : 18)}" text-anchor="middle">${esc(b.name)}</text>`);
  let yy = g.top + hh;
  if (b.fields?.length) {
    uml.push(`<line class="um-sep" x1="${g.x}" y1="${yy}" x2="${g.x + g.w}" y2="${yy}"/>`);
    b.fields.forEach((f, i) => uml.push(`<text class="um-member" x="${g.x + 10}" y="${yy + 15 + i * LH}">${esc(f)}</text>`));
    yy += b.fields.length * LH + 9;
  }
  if (b.methods?.length) {
    uml.push(`<line class="um-sep" x1="${g.x}" y1="${yy}" x2="${g.x + g.w}" y2="${yy}"/>`);
    b.methods.forEach((m, i) => uml.push(`<text class="um-member um-method" x="${g.x + 10}" y="${yy + 15 + i * LH}">${esc(m)}</text>`));
  }
  uml.push(`</g>`);
}

const umlSvg = `<svg viewBox="0 0 ${UW} ${UH}" role="img" aria-labelledby="um-title um-desc" class="dg-svg">
<title id="um-title">${esc(t('uml.svg_title'))}</title>
<desc id="um-desc">${esc(t('uml.svg_desc'))}</desc>
<defs>
  <marker id="um-extends" viewBox="0 0 14 14" refX="7" refY="1" markerWidth="14" markerHeight="14" orient="0" markerUnits="userSpaceOnUse"><path class="um-mk-hollow" d="M7 1 13 12 1 12z"/></marker>
  <marker id="um-owns" viewBox="0 0 16 10" refX="1" refY="5" markerWidth="16" markerHeight="10" orient="auto" markerUnits="userSpaceOnUse"><path class="um-mk-fill" d="M1 5 8 1 15 5 8 9z"/></marker>
  <marker id="um-open" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="10" markerHeight="10" orient="auto" markerUnits="userSpaceOnUse"><path class="um-mk-open" d="M1 1 9 5 1 9"/></marker>
</defs>
${uml.join('\n')}
${umlLabels.join('\n')}
</svg>`;
---
<section id="internals" class="dg-sec" aria-labelledby="dg-title" data-diagrams>
  <div class="wrap">
    <p class="eyebrow">{t('dg.eyebrow')}</p>
    <h2 id="dg-title" class="section-title">{t('dg.title')}</h2>
    <p class="intro">{t('dg.intro')}</p>

    <div class="tabs" role="tablist" aria-label={t('dg.tabs_label')}>
      <button type="button" class="tab" role="tab" id="tab-seq" aria-controls="panel-seq" aria-selected="true" data-tab="seq">{t('dg.tab.seq')} <span class="kind">{t('dg.tab.seq_kind')}</span></button>
      <button type="button" class="tab" role="tab" id="tab-uml" aria-controls="panel-uml" aria-selected="false" data-tab="uml">{t('dg.tab.uml')} <span class="kind">{t('dg.tab.uml_kind')}</span></button>
    </div>

    <div class="panel" role="tabpanel" id="panel-seq" aria-labelledby="tab-seq" data-panel="seq">
      <p class="swipe" aria-hidden="true">{t('dg.swipe')}</p>
      <div class="scroller" tabindex="0" aria-label={t('dg.seq_scroll_label')}>
        <div class="canvas canvas-seq" set:html={seqSvg} />
      </div>
      <ul class="key" aria-label={t('dg.key_label')}>
        <li><svg viewBox="0 0 40 10" aria-hidden="true"><line x1="2" y1="5" x2="32" y2="5" class="k-line" /><path d="M30 1 38 5 30 9z" class="k-fill" /></svg>{t('dg.key.call')}</li>
        <li><svg viewBox="0 0 40 10" aria-hidden="true"><line x1="2" y1="5" x2="36" y2="5" class="k-line" /><path d="M31 1 38 5 31 9" class="k-open" /></svg>{t('dg.key.async')}</li>
        <li><svg viewBox="0 0 40 10" aria-hidden="true"><line x1="2" y1="5" x2="36" y2="5" class="k-line k-dash" /><path d="M31 1 38 5 31 9" class="k-open" /></svg>{t('dg.key.return')}</li>
        <li><span class="k-thread"></span>{t('dg.key.thread')}</li>
      </ul>
    </div>

    <div class="panel" role="tabpanel" id="panel-uml" aria-labelledby="tab-uml" data-panel="uml">
      <p class="swipe" aria-hidden="true">{t('dg.swipe')}</p>
      <div class="scroller" tabindex="0" aria-label={t('dg.uml_scroll_label')}>
        <div class="canvas canvas-uml" set:html={umlSvg} />
      </div>
      <ul class="key" aria-label={t('dg.key_label')}>
        <li><svg viewBox="0 0 40 14" aria-hidden="true"><line x1="2" y1="7" x2="28" y2="7" class="k-line" /><path d="M28 1 38 7 28 13z" class="k-hollow" /></svg>{t('dg.key.extends')}</li>
        <li><svg viewBox="0 0 40 14" aria-hidden="true"><path d="M2 7 9 3 16 7 9 11z" class="k-fill" /><line x1="16" y1="7" x2="38" y2="7" class="k-line" /></svg>{t('dg.key.owns')}</li>
