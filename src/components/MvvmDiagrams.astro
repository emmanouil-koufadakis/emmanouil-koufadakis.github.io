  .canvas :global(.sq-pill) { fill: var(--color-bg); stroke: color-mix(in oklab, oklch(0.62 0.13 200) 55%, transparent); }
  .canvas :global(.sq-pill-text) { font-size: 10.5px; font-weight: 600; fill: var(--color-ink-soft); }

  /* ---------- class diagram ---------- */
  .canvas :global(.um-edge) { fill: none; stroke: var(--color-ink-soft); stroke-width: 1.4; }
