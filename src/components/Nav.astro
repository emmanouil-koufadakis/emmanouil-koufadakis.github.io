---
import { Image } from 'astro:assets';
import Monogram from './Monogram.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/cv';
import { headshot } from '../data/headshot';

const links = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#work', label: 'Case studies' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#certifications', label: 'Certifications' },
  { href: '/#credits', label: 'Full CV' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a href="/" class="brand">
      {
        headshot ? (
          <Image src={headshot} alt="" width={160} quality={80} loading="eager" class="avatar" />
        ) : (
          <Monogram size={36} uid="nav" />
        )
      }
      <span class="brand-name">{profile.name}</span>
    </a>
    <nav class="desktop" aria-label="Main">
      <ul class="links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <ThemeToggle />
      <a class="btn btn-primary cv-btn" href={profile.cvFile} download>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19.5h14" /></svg>
        <span>CV <span class="cv-ext">PDF</span></span>
      </a>
      <button class="menu-btn" type="button" popovertarget="site-menu" aria-label="Menu">
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <!-- Phone / tablet menu: a popover gives Esc, outside-click and focus handling for free. -->
  <nav id="site-menu" class="menu" popover aria-label="Main">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li class="menu-cv">
        <a href={profile.cvFile} download>Download CV (PDF)</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
    background: linear-gradient(to bottom, color-mix(in oklab, var(--color-bg) 70%, transparent), transparent);
  }
  .nav[data-scrolled] {
    background: color-mix(in oklab, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom-color: color-mix(in oklab, var(--color-ink) 8%, transparent);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    border-radius: 10px;
  }
  .brand:focus-visible { outline: none; box-shadow: var(--focus-ring); }
  .brand :global(svg) { flex: none; }
  .brand :global(.avatar) {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
    box-shadow: 0 0 0 2px var(--color-accent);
  }
  nav.desktop { margin-left: auto; }
  .links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: inline-block;
    padding: 0.55rem 0.8rem;
    border-radius: 8px;
    color: var(--color-ink-soft);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.9375rem;
    transition: color 0.2s, background-color 0.2s;
  }
  .links a:hover { color: var(--color-ink); background: color-mix(in oklab, var(--color-ink) 7%, transparent); }
  .links a:focus-visible { outline: none; box-shadow: var(--focus-ring); color: var(--color-ink); }
  .actions { display: flex; align-items: center; gap: 0.6rem; }
  .cv-btn { min-height: 44px; padding: 0.6rem 1rem; font-size: 0.9375rem; }

  /* ---------- hamburger + menu (shown below the desktop breakpoint) ---------- */
  .menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    color: var(--color-ink);
    background: color-mix(in oklab, var(--color-ink) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .menu-btn:hover { background: color-mix(in oklab, var(--color-ink) 14%, transparent); }
  .menu-btn:focus-visible { outline: none; box-shadow: var(--focus-ring); }
  .bars { display: grid; gap: 4px; width: 18px; }
  .bars i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.25s var(--ease-out-soft), opacity 0.2s;
  }
  /* Bars turn into an X while the menu is open. */
  .nav:has(.menu:popover-open) .bars i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav:has(.menu:popover-open) .bars i:nth-child(2) { opacity: 0; }
  .nav:has(.menu:popover-open) .bars i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .menu {
    position: fixed;
    inset: calc(var(--nav-h) + 6px) var(--gutter) auto auto;
    width: min(20rem, calc(100vw - 2 * var(--gutter)));
    margin: 0;
    padding: 0.5rem;
    border-radius: 16px;
    border: 1px solid var(--color-line);
    background: var(--color-bg-raised);
    color: var(--color-ink);
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.5);
    opacity: 0;
    translate: 0 -8px;
    transition: opacity 0.2s, translate 0.2s var(--ease-out-soft), overlay 0.2s allow-discrete, display 0.2s allow-discrete;
  }
  .menu:popover-open { opacity: 1; translate: 0 0; }
  @starting-style {
    .menu:popover-open { opacity: 0; translate: 0 -8px; }
  }
  .menu::backdrop { background: rgb(0 0 0 / 0.3); }
  .menu ul { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .menu a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.0625rem;
  }
  .menu a:hover { background: color-mix(in oklab, var(--color-ink) 8%, transparent); }
  .menu a:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--color-accent); }
  .menu-cv { margin-top: 0.35rem; padding-top: 0.35rem; border-top: 1px solid var(--color-line); }
  .menu-cv a { color: var(--color-accent); }

  @media (max-width: 1180px) {
    nav.desktop { display: none; }
    .actions { margin-left: auto; }
    .menu-btn { display: grid; }
  }
  @media (min-width: 1181px) {
    .menu { display: none; }
  }
  @media (max-width: 560px) {
    /* Visually hidden but still the link's accessible name. */
    .brand-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .cv-ext { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    let ticking = false;
    const update = () => {
      nav.toggleAttribute('data-scrolled', window.scrollY > 24);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  // Close the menu after picking a link, and if the window grows to desktop width.
  const menu = document.querySelector<HTMLElement>('#site-menu');
  if (menu && 'hidePopover' in menu) {
    const close = () => {
      if (menu.matches(':popover-open')) menu.hidePopover();
    };
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) close();
    });
    window.matchMedia('(min-width: 1181px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>
