---
import Shine from './Shine.astro';
import { formatMonth, type Post } from '../data/cv';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const when = formatMonth(post.date.slice(0, 7));
const cta = post.kind === 'LinkedIn post' ? 'Read on LinkedIn' : 'Read the article';
---
<li>
  <a class="post" href={post.url} target="_blank" rel="noopener" data-rail-item data-track={`post/${post.id}`}>
    <div class="banner art" style={`--h: ${post.hue}`}>
      <span class="badge">{post.kind}</span>
      <div class="title-block">
        <h3>{post.title}</h3>
        {post.subtitle && <p class="sub">{post.subtitle}</p>}
      </div>
      <Shine />
    </div>
    <div class="body">
      <p class="meta">
        <time datetime={post.date}>{when}</time>{post.format && ` · ${post.format}`}
      </p>
      <p class="summary">{post.summary}</p>
      <ul class="topics" aria-label="Topics">
        {post.topics.map((t) => <li>{t}</li>)}
      </ul>
      <span class="more">
        {cta}<span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true">↗</span>
      </span>
    </div>
  </a>
</li>

<style>
  .post {
    display: flex;
    flex-direction: column;
    width: clamp(290px, 30vw, 400px);
    height: 100%;
    color: var(--color-ink);
    text-decoration: none;
    border-radius: 16px;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
    overflow: hidden;
    transition: transform 0.3s var(--ease-out-soft), box-shadow 0.3s var(--ease-out-soft), border-color 0.3s;
  }
  .post:hover { transform: scale(1.02); border-color: color-mix(in oklab, var(--color-accent) 45%, var(--color-line)); }
  .post:focus-visible { outline: none; transform: scale(1.04); box-shadow: var(--focus-ring), var(--focus-glow); }

  .banner {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 8;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.5), transparent 65%);
  }
  .banner > * { position: relative; z-index: 1; }
  .banner > .badge { position: absolute; }
  .badge {
    top: 0.9rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 5px;
    background: rgb(0 0 0 / 0.35);
  }
  h3 {
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .sub { margin-top: 0.35rem; font-size: 0.875rem; opacity: 0.9; }

  .body { flex: 1; display: flex; flex-direction: column; gap: 0.6rem; padding: 1rem 1.15rem 1.15rem; }
  .meta { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-faint); }
  .summary {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .topics { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0; padding: 0; list-style: none; }
  .topics li {
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    background: color-mix(in oklab, var(--color-ink) 7%, transparent);
  }
  .more { margin-top: auto; padding-top: 0.3rem; font-size: 0.875rem; font-weight: 600; color: var(--color-accent); }
</style>
